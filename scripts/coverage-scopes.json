{
  "scopes": [
    {
      "name": "frontend",
      "kind": "vitest",
      "report": "coverage/frontend/coverage-summary.json",
      "include": ["src/**/*.ts"],
      "exclude": ["**/*.test.ts"],
      "metrics": ["lines", "branches"],
      "status": "active"
    },
    {
      "name": "rust-shared",
      "kind": "llvm-cov",
      "report": "coverage/rust.json",
      "include": ["crates/**/src/**/*.rs"],
      "exclude": ["crates/**/src/**/tests.rs"],
      "metrics": ["lines"],
      "status": "active",
      "declarativeFiles": [
        {
          "path": "crates/recorder-core/src/lib.rs",
          "reason": "Crate documentation and module declarations only; llvm-cov reports no functions."
        },
        {
          "path": "crates/recorder-core/src/audio/mod.rs",
          "reason": "Module declarations only; llvm-cov reports no functions."
        },
        {
          "path": "crates/recorder-core/src/capture/mod.rs",
          "reason": "Module declarations only; llvm-cov reports no functions."
        }
      ]
    },
    {
      "name": "rust-tauri",
      "kind": "llvm-cov",
      "report": "coverage/rust.json",
      "include": ["src-tauri/src/**/*.rs"],
      "exclude": [],
      "metrics": ["lines"],
      "status": "active",
      "justifiedExclusions": [
        {
          "path": "src-tauri/src/main.rs",
          "reason": "Entry point that runs the app on the real window event loop, which unit tests cannot start. It only calls configure and exit_code in lib.rs, which are tested on the Tauri mock runtime; main.rs is verified by the tauri dev and packaged-window checks (P00 Task 2 and Task 7). Approved by the project owner on 2026-11-13."
        }
      ]
    },
    {
      "name": "swift-bridge",
      "kind": "xccov",
      "report": "coverage/swift.json",
      "include": ["native/macos/**/*.swift"],
      "exclude": [],
      "metrics": ["lines"],
      "status": "pending"
    }
  ]
}
